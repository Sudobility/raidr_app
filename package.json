{
  "name": "raidr_app",
  "private": true,
  "version": "0.1.21",
  "description": "Browse raidr MCP servers and agent skills, with connection and install docs",
  "license": "BUSL-1.1",
  "author": "Sudobility Inc.",
  "type": "module",
  "scripts": {
    "generate:cf-env": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-cloudflare-env.ts -o /tmp/generate-cloudflare-env.ts && bunx tsx /tmp/generate-cloudflare-env.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "deploy": "bunx wrangler pages deploy dist --project-name raidr-app",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@heroicons/react": "~2.2.0",
    "@sudobility/auth-components": "^1.0.12",
    "@sudobility/auth_lib": "^0.0.119",
    "@sudobility/building_blocks": "^0.0.341",
    "@sudobility/components": "^5.3.44",
    "@sudobility/design": "^1.1.66",
    "@sudobility/devops-components": "^2.0.20",
    "@sudobility/di": "^1.5.79",
    "@sudobility/di_web": "^0.1.262",
    "@sudobility/entity-components": "^1.0.14",
    "@sudobility/entity_client": "^0.0.55",
    "@sudobility/entity_pages": "^0.0.185",
    "@sudobility/raidr_client": "^0.1.13",
    "@sudobility/raidr_lib": "^0.1.25",
    "@sudobility/raidr_types": "^0.1.17",
    "@sudobility/seo_lib": "^0.0.47",
    "@sudobility/subscription-components": "^1.0.32",
    "@sudobility/subscription_lib": "^0.0.57",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@xyflow/react": "~12.12.0",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~12.19.0",
    "i18next": "~25.10.10",
    "i18next-browser-languagedetector": "~8.2.1",
    "i18next-http-backend": "~3.0.6",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-helmet-async": "~2.0.5",
    "react-i18next": "~16.6.6",
    "react-markdown": "~10.1.0",
    "react-router-dom": "~7.18.4",
    "remark-gfm": "~4.0.1",
    "tailwind-merge": "~3.7.0",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@testing-library/dom": "~10.4.2",
    "@testing-library/react": "~16.3.3",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react-swc": "~4.3.3",
    "autoprefixer": "~10.6.1",
    "eslint": "~9.39.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~16.5.0",
    "happy-dom": "~20.14.6",
    "postcss": "~8.5.31",
    "prettier": "~3.9.10",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.72.0",
    "vite": "~7.3.7",
    "vitest": "~4.1.12",
    "playwright": "~1.64.1",
    "tsx": "~4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/raidr_app.git"
  }
}
